rules_version = '2';

// Firebase Storage Security Rules for Market-Cash
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isBootstrapAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email in ["merveillematondo2027@gmail.com", "emmanuelmungwele1@gmail.com"]
      );
    }

    function isAdminGeneral() {
      return isSignedIn() && (
        isBootstrapAdminEmail() || getUserRole() == 'admin_general'
      );
    }

    function isChefAgence() {
      return isSignedIn() && (
        isAdminGeneral() || getUserRole() == 'chef_agence'
      );
    }

    function isDesignerGraphique() {
      return isSignedIn() && (
        isAdminGeneral() || getUserRole() == 'designer_graphique'
      );
    }

    // ==========================================
    // PAYMENT PROOFS (Demandes d'achat de cartes)
    // ==========================================
    match /payment-proofs/{userId}/{fileName} {
      allow read: if isOwner(userId) || isChefAgence();
      allow create: if isOwner(userId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if isOwner(userId) || isChefAgence();
    }

    match /identity-proofs/{userId}/{fileName} {
      allow read: if isOwner(userId) || isChefAgence();
      allow create: if isOwner(userId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if isOwner(userId) || isChefAgence();
    }

    match /market-cash/purchase-proofs/{userId}/{fileName} {
      allow read: if isOwner(userId) || isChefAgence();
      allow create: if isOwner(userId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if isOwner(userId) || isChefAgence();
    }

    // ==========================================
    // PVC CARDS & DESIGNS (Atelier Designer / Production)
    // ==========================================
    match /card-designs/{cardId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if (isAdminGeneral() || isDesignerGraphique())
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if isAdminGeneral();
    }

    match /market-cash/cards/{cardIdentifier}/{fileName} {
      allow read: if isChefAgence() || isDesignerGraphique();
      allow create, update: if isChefAgence()
        && fileName == 'front.png'
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow delete: if isAdminGeneral();
    }

    // ==========================================
    // USER AVATARS & ID PROOFS
    // ==========================================
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    // Default deny for unlisted paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
