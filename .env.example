# Existing app variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ============================================================
# MARKET-CASH CREATOR PROVIDERS — SERVER SECRETS ONLY
# Never prefix secret keys with VITE_. Configure production
# credentials with Firebase/Google Cloud secrets when approved.
# ============================================================

# Fincra — FCY individual accounts (USD/EUR/GBP/CAD)
FINCRA_API_KEY=""
FINCRA_API_BASE_URL="https://sandboxapi.fincra.com"
FINCRA_WEBHOOK_SECRET=""

# Payoneer — payee onboarding / receiving / withdrawal programs
PAYONEER_CLIENT_ID=""
PAYONEER_CLIENT_SECRET=""
PAYONEER_PROGRAM_ID=""
PAYONEER_API_BASE_URL="https://api.sandbox.payoneer.com"
PAYONEER_WEBHOOK_SECRET=""

# Thunes — collection accounts / payouts
THUNES_API_KEY=""
THUNES_API_SECRET=""
THUNES_API_BASE_URL=""
THUNES_WEBHOOK_SECRET=""

# Flutterwave — African virtual-account and payment rails
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_API_BASE_URL="https://developersandbox-api.flutterwave.com"
FLUTTERWAVE_WEBHOOK_SECRET=""

# Creator orchestration
CREATOR_PROVIDER_DEFAULT="fincra"
CREATOR_PROVIDER_MODE="sandbox"
