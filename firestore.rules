rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isBootstrapAdminEmail() { return isSignedIn() && request.auth.token.email in ['merveillematondo2027@gmail.com','emmanuelmungwele1@gmail.com']; }
    function isOfficialRole(role) { return role in ['client','admin_general','chef_agence','designer_graphique','livreur']; }
    function isAdminGeneral() { return isSignedIn() && (isBootstrapAdminEmail() || getUserRole() == 'admin_general'); }
    function isChefAgence() { return isSignedIn() && (isAdminGeneral() || getUserRole() == 'chef_agence'); }
    function isDesignerGraphique() { return isSignedIn() && (isAdminGeneral() || getUserRole() == 'designer_graphique'); }
    function isLivreur() { return isSignedIn() && (isAdminGeneral() || getUserRole() == 'livreur'); }
    function isStaff() { return isAdminGeneral() || isChefAgence() || isDesignerGraphique() || isLivreur(); }
    function isClientDeliveryRoleNotification(notificationId) {
      let deliveryId=request.resource.data.deliveryId; let targetRole=request.resource.data.userId; let delivery=get(/databases/$(database)/documents/physical_card_requests/$(deliveryId));
      return getUserRole()=='client' && targetRole in ['admin_general','livreur'] && request.resource.data.keys().hasOnly(['id','userId','targetRole','title','message','type','read','createdAt','category','cardIdentifier','deliveryId']) && request.resource.data.id==notificationId && request.resource.data.targetRole==targetRole && notificationId==deliveryId+'_'+targetRole && request.resource.data.category=='delivery' && request.resource.data.type=='info' && request.resource.data.cardIdentifier is string && exists(/databases/$(database)/documents/physical_card_requests/$(deliveryId)) && delivery.data.userId==request.auth.uid && delivery.data.status=='pending' && delivery.data.cardIdentifier==request.resource.data.cardIdentifier && ((targetRole=='admin_general' && request.resource.data.title=='Nouvelle demande de livraison' && request.resource.data.message=='Une nouvelle demande de livraison client est disponible.') || (targetRole=='livreur' && request.resource.data.title=='Nouvelle course disponible' && request.resource.data.message=='Une nouvelle demande de livraison est disponible.'));
    }
    match /app_settings/{settingId} { allow read: if isSignedIn(); allow write: if isAdminGeneral(); }
    match /payment_settings/{settingId} { allow read: if isSignedIn(); allow write: if isAdminGeneral(); }
    match /counters/global_card_counter { allow read: if isChefAgence(); allow create: if isChefAgence() && request.resource.data.keys().hasOnly(['count','lastGeneratedAt']) && request.resource.data.count is int && request.resource.data.count==1 && request.resource.data.lastGeneratedAt is int; allow update: if isChefAgence() && request.resource.data.keys().hasOnly(['count','lastGeneratedAt']) && request.resource.data.count is int && request.resource.data.count==resource.data.count+1 && request.resource.data.lastGeneratedAt is int; allow delete: if isAdminGeneral(); }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminGeneral() || isChefAgence();
      allow create: if (isOwner(userId) && request.resource.data.uid==userId && (request.resource.data.role=='client' || (isBootstrapAdminEmail() && request.resource.data.role=='admin_general'))) || (isAdminGeneral() && request.resource.data.uid==userId && isOfficialRole(request.resource.data.role));
      allow update: if (isOwner(userId) && request.resource.data.uid==request.auth.uid && request.resource.data.role==resource.data.role && request.resource.data.email==resource.data.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','avatar','pinHash','useBiometrics','updatedAt'])) || (isAdminGeneral() && request.resource.data.uid==userId && isOfficialRole(request.resource.data.role));
      allow delete: if isAdminGeneral();
      match /cards/{cardId} { allow read: if isOwner(userId) || isChefAgence(); allow write: if isChefAgence(); }
    }
    match /cards/{cardId} { allow read: if (isSignedIn() && resource.data.userId==request.auth.uid) || isStaff(); allow create: if isChefAgence(); allow delete: if isAdminGeneral(); allow update: if isChefAgence() || (isDesignerGraphique() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['printStatus','printedAt','printedBy','updatedAt','printFileUrl','cardDesignUrl','designUrl'])) || (isSignedIn() && resource.data.userId==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])); }
    match /card_purchase_requests/{requestId} { allow read: if (isSignedIn() && resource.data.userId==request.auth.uid) || isChefAgence(); allow create: if isSignedIn() && request.resource.data.userId==request.auth.uid; allow update: if isChefAgence(); allow delete: if isAdminGeneral(); }
    match /physical_card_requests/{requestId} { allow read: if (isSignedIn() && resource.data.userId==request.auth.uid) || isStaff(); allow create: if isSignedIn() && request.resource.data.userId==request.auth.uid; allow update: if isChefAgence() || (isDesignerGraphique() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','printedAt','updatedAt'])) || (isLivreur() && (resource.data.assignedLivreurId==request.auth.uid || request.resource.data.assignedLivreurId==request.auth.uid || resource.data.status=='pending') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deliveredAt','updatedAt','assignedLivreurId'])); allow delete: if isAdminGeneral(); }
    match /notifications/{notificationId} { allow read: if isSignedIn() && (isAdminGeneral() || resource.data.userId==request.auth.uid || resource.data.userId=='all' || resource.data.userId==getUserRole()); allow create: if isSignedIn() && request.resource.data.keys().hasAll(['userId','title','message','type','read','createdAt']) && request.resource.data.keys().hasOnly(['id','userId','targetRole','title','message','type','read','createdAt','category','requestId','cardId','cardName','cardIdentifier','isUrgent','deliveryId']) && request.resource.data.userId is string && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=200 && request.resource.data.message is string && request.resource.data.message.size()>0 && request.resource.data.message.size()<=2000 && request.resource.data.type in ['success','error','info'] && request.resource.data.read==false && request.resource.data.createdAt is int && (isStaff() || request.resource.data.userId==request.auth.uid || isClientDeliveryRoleNotification(notificationId)); allow update: if isSignedIn() && (isAdminGeneral() || resource.data.userId==request.auth.uid || resource.data.userId=='all' || resource.data.userId==getUserRole()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool; allow delete: if isSignedIn() && (isAdminGeneral() || resource.data.userId==request.auth.uid || resource.data.userId=='all' || resource.data.userId==getUserRole()); }
    match /help_articles/{articleId} { allow read: if isSignedIn(); allow write: if isAdminGeneral(); }
    match /appLogs/{logId} {
      allow read: if isAdminGeneral() || isChefAgence();
      allow delete: if isAdminGeneral();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['timestamp','level','category','event','message','userId']) && request.resource.data.keys().hasOnly(['timestamp','level','category','event','message','userId','userEmail','userRole','route','operation','collection','documentId','errorCode','errorName','stack','metadata','success']) && request.resource.data.userId==request.auth.uid && request.resource.data.timestamp is int && request.resource.data.level in ['INFO','SUCCESS','WARNING','ERROR','CRITICAL'] && request.resource.data.category in ['AUTH','FIRESTORE','STORAGE','PAYMENT','CARD','STOCK','PHYSICAL_CARD','DELIVERY','USER','NOTIFICATION','HELP','DESIGN','SECURITY','UI','SYSTEM'] && request.resource.data.event is string && request.resource.data.event.size()>0 && request.resource.data.event.size()<=120 && request.resource.data.message is string && request.resource.data.message.size()<=2000;
      allow update: if false;
    }
    match /card_designs/{designId} { allow read: if isSignedIn(); allow write: if isAdminGeneral() || isDesignerGraphique(); }
    match /{document=**} { allow read, write: if false; }
  }
}
