rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE-BASED ACCESS CONTROL
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return hasUserDoc() && ('role' in getUserData())
        ? getUserData().role
        : 'client';
    }

    function getUserAgencyId() {
      return hasUserDoc() && ('agencyId' in getUserData())
        ? getUserData().agencyId
        : '';
    }

    function isAdminGeneral() {
      return isSignedIn() && (
        (request.auth.token != null && (request.auth.token.email == 'merveillematondo2027@gmail.com' || request.auth.token.email == 'emmanuelmungwele1@gmail.com')) ||
        getUserRole() in ['admin_general', 'admin']
      );
    }

    function isChefAgence() {
      return isSignedIn() && (
        isAdminGeneral() ||
        getUserRole() in ['chef_agence', 'chef']
      );
    }

    function isDesignerGraphique() {
      return isSignedIn() && (
        isAdminGeneral() ||
        getUserRole() in ['designer_graphique', 'designer']
      );
    }

    function isLivreur() {
      return isSignedIn() && (
        isAdminGeneral() ||
        getUserRole() in ['livreur', 'delivery']
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdminGeneral() ||
        isChefAgence() ||
        isDesignerGraphique() ||
        isLivreur()
      );
    }


    // ==============================
    // APP & PAYMENT SETTINGS
    // ==============================

    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdminGeneral();
    }

    match /payment_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdminGeneral();
    }


    // ==============================
    // COUNTERS (Card ID generator)
    // ==============================

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }


    // ==============================
    // USERS
    // ==============================

    match /users/{userId} {

      // Lecture : l'utilisateur lit son propre profil. Le staff lit pour les opérations métiers.
      allow read: if isOwner(userId) || isStaff();

      // Création : Un client crée son profil avec rôle "client". L'Admin Général peut créer tout profil.
      allow create: if
        (
          isOwner(userId)
          && request.resource.data.uid == request.auth.uid
        )
        ||
        isAdminGeneral();

      // Modification : Le client modifie ses infos sans changer son rôle ni son uid. Seul l'Admin Général peut changer les rôles.
      allow update: if
        (
          isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == resource.data.role
        )
        ||
        isAdminGeneral();

      // Suppression réservée à l'administrateur général.
      allow delete: if isAdminGeneral();


      // ==============================
      // USER CARDS SUBCOLLECTION
      // ==============================

      match /cards/{cardId} {
        allow read: if isOwner(userId) || isChefAgence();
        allow write: if isChefAgence();
      }
    }


    // ==============================
    // CARDS (Production & Issued Library)
    // ==============================

    match /cards/{cardId} {

      // Lecture :
      // - Le client lit uniquement ses propres cartes
      // - Admin Général, Chef d'Agence et Designer Graphique peuvent lire
      allow read: if
        (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        )
        ||
        isChefAgence()
        ||
        isDesignerGraphique();

      // Création : Admin Général et Chef d'Agence
      allow create: if isChefAgence();

      // Suppression : Seul l'Administrateur Général
      allow delete: if isAdminGeneral();

      // Modification :
      // - Admin Général et Chef d'Agence : complet
      // - Designer Graphique : uniquement les champs d'impression
      allow update: if
        isChefAgence()
        ||
        (
          isDesignerGraphique()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['printStatus', 'printedAt', 'printedBy', 'updatedAt', 'printFileUrl', 'cardDesignUrl'])
        );
    }


    // ==============================
    // CARD PURCHASE REQUESTS
    // ==============================

    match /card_purchase_requests/{requestId} {

      // Lecture :
      // - Le client lit uniquement ses propres demandes
      // - Admin Général et Chef d'Agence peuvent lire
      allow read: if
        (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        )
        ||
        isChefAgence();

      // Création : Un client connecté crée une demande
      allow create: if
        (
          isSignedIn()
          && request.resource.data.userId == request.auth.uid
        )
        ||
        isChefAgence();

      // Modification : Admin Général et Chef d'Agence
      allow update: if isChefAgence();

      // Suppression : Seul l'Administrateur Général
      allow delete: if isAdminGeneral();
    }


    // ==============================
    // PHYSICAL CARD DELIVERY REQUESTS
    // ==============================

    match /physical_card_requests/{requestId} {

      // Lecture :
      // - Le client lit uniquement ses propres commandes
      // - Admin Général, Chef d'Agence, Designer Graphique et Livreur peuvent lire
      allow read: if
        (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        )
        ||
        isChefAgence()
        ||
        isDesignerGraphique()
        ||
        isLivreur();

      // Création :
      // - Le client crée sa commande
      // - Admin Général et Chef d'Agence
      allow create: if
        (
          isSignedIn()
          && request.resource.data.userId == request.auth.uid
        )
        ||
        isChefAgence();

      // Modification :
      // - Admin Général et Chef d'Agence : gestion & attribution
      // - Livreur : mise à jour du statut, dates, et rapports de remise
      allow update: if
        isChefAgence()
        ||
        (
          isLivreur()
          && (
            resource.data.assignedLivreurId == request.auth.uid
            || resource.data.status == "pending"
            || request.resource.data.assignedLivreurId == request.auth.uid
          )
        );

      // Suppression réservée à l'administrateur général
      allow delete: if isAdminGeneral();
    }


    // ==============================
    // NOTIFICATIONS
    // ==============================

    match /notifications/{notificationId} {

      // Lecture : l'utilisateur lit ses notifications ou notifications de son rôle
      allow read: if
        isSignedIn() && (
          resource.data.userId == request.auth.uid
          || resource.data.userId == getUserRole()
          || resource.data.userId == 'all'
          || (('targetRole' in resource.data) && (resource.data.targetRole == getUserRole() || resource.data.targetRole == 'all'))
          || isChefAgence()
        );

      // Création : Tout utilisateur connecté
      allow create: if isSignedIn();

      // Modification : Marquage comme lue
      allow update: if
        isSignedIn() && (
          resource.data.userId == request.auth.uid
          || isStaff()
        );

      // Suppression
      allow delete: if
        isSignedIn() && (
          resource.data.userId == request.auth.uid
          || isAdminGeneral()
        );
    }


    // ==============================
    // HELP ARTICLES
    // ==============================

    match /help_articles/{articleId} {
      allow read: if isSignedIn();
      allow write: if isAdminGeneral();
    }


    // ==============================
    // DEFAULT DENY
    // ==============================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
